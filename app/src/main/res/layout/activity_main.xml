<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_intro" />

        <Button
            android:id="@+id/open_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/search_title" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/step_accessibility" />

        <TextView
            android:id="@+id/accessibility_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step_accessibility_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/open_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_accessibility" />

            <Button
                android:id="@+id/open_app_info"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_app_info" />
        </LinearLayout>

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/step_assistant" />

        <TextView
            android:id="@+id/assistant_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step_assistant_hint" />

        <Button
            android:id="@+id/open_assistant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_assistant" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/step_dictionaries" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step_dictionaries_hint" />

        <LinearLayout
            android:id="@+id/dictionary_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/import_dictionary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_dictionary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/export_collection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/export_collection" />

            <Button
                android:id="@+id/import_collection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/import_collection" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collection_hint" />


        <TextView
            android:id="@+id/import_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sort_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/sort_dictionary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />

            <Button
                android:id="@+id/sort_order"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/average_frequencies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/average_frequencies" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/average_frequencies_hint" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/audio_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_hint" />

        <CheckBox
            android:id="@+id/audio_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_enabled" />

        <Button
            android:id="@+id/audio_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <CheckBox
            android:id="@+id/audio_auto_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_auto_play" />

        <TextView
            android:id="@+id/audio_volume_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/audio_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <Button
            android:id="@+id/audio_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/step_anki" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step_anki_hint" />

        <EditText
            android:id="@+id/anki_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/anki_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/anki_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/anki_key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/anki_deck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />

            <Button
                android:id="@+id/anki_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/anki_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cards_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cards_hint" />

        <Button
            android:id="@+id/cards_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cards_import" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/cards_deck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />

            <Button
                android:id="@+id/cards_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/cards_fields"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cards_fields" />

            <Button
                android:id="@+id/cards_templates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cards_templates" />
        </LinearLayout>

        <EditText
            android:id="@+id/cards_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cards_tags_hint"
            android:importantForAutofill="no"
            android:inputType="text" />

        <CheckBox
            android:id="@+id/cards_check_duplicates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cards_check_duplicates" />

        <Button
            android:id="@+id/cards_duplicate_behavior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/cards_duplicate_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/cards_check_all_models"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cards_check_all_models" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cards_duplicates_hint" />

        <CheckBox
            android:id="@+id/cards_word_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cards_word_audio" />

        <TextView
            android:id="@+id/cards_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/marks_section"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/marks_section_hint" />

        <Button
            android:id="@+id/marks_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/marks_open" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/step_usage" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/usage_hint" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/step_example" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/step_example_hint" />

        <Button
            android:id="@+id/import_example"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_example" />

        <LinearLayout
            android:id="@+id/example_sentences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Drawn text to try OCR on, wrapped like an Instagram post: a container describing the
             picture, which mustn't hide the text in it -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/example_image_description"
            android:focusable="true">

            <ImageView
                android:id="@+id/example_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
