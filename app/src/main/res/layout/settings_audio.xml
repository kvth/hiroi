<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_audio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_hint" />

        <CheckBox
            android:id="@+id/audio_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_enabled" />

        <Button
            android:id="@+id/audio_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/local_audio_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_audio_hint" />

        <TextView
            android:id="@+id/local_audio_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <ProgressBar
            android:id="@+id/local_audio_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/local_audio_choose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_audio_choose" />

            <Button
                android:id="@+id/local_audio_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_audio_order" />

            <Button
                android:id="@+id/local_audio_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/local_audio_remove" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/audio_auto_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_auto_play" />

        <TextView
            android:id="@+id/audio_volume_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/audio_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <Button
            android:id="@+id/audio_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
