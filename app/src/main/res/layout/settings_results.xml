<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_results"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/sort_dictionary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />

            <Button
                android:id="@+id/sort_order"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/average_frequencies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/average_frequencies" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/average_frequencies_hint" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pitch_accent_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pitch_accent_hint" />

        <CheckBox
            android:id="@+id/pitch_accent_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pitch_accent_text" />

        <CheckBox
            android:id="@+id/pitch_accent_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pitch_accent_position" />

        <CheckBox
            android:id="@+id/pitch_accent_graph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pitch_accent_graph" />

        <TextView
            style="@android:style/TextAppearance.DeviceDefault.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grouping_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grouping_hint" />

        <Button
            android:id="@+id/result_grouping"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/related_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grouping_related_hint" />

        <Button
            android:id="@+id/main_dictionary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <Button
            android:id="@+id/secondary_dictionaries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>
</ScrollView>
