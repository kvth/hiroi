<?xml version="1.0" encoding="utf-8"?>
<!-- The translation settings may hold API keys: they stay on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="translation.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="translation.xml" />
    </device-transfer>
</data-extraction-rules>
